generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// TENANTS & USERS
// =====================

model Tenant {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  email        String
  phone        String?
  country      String    @default("CL")
  timezone     String    @default("America/Santiago")
  currency     String    @default("CLP")
  language     String    @default("es")
  plan         String    @default("free")
  status       String    @default("trial")
  trialEndsAt  DateTime?
  customDomain String?
  branding     Json?
  metadata     Json?

  users         User[]
  products      Product[]
  orders        Order[]
  sales         Sale[]
  connections   Connection[]
  warehouses    Warehouse[]
  webhooks      Webhook[]
  taxDocuments  TaxDocument[]
  bsaleClients  BsaleClientCache[]
  webhookEvents MarketplaceWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  email            String
  password         String
  firstName        String
  lastName         String
  role             String    @default("staff")
  permissions      Json?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  emailVerified    Boolean   @default(false)
  status           String    @default("active")
  lastLogin        DateTime?
  metadata         Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

// =====================
// PRODUCTS
// =====================

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  sku              String
  // Código de barras opcional (UPC, EAN-13, EAN-8, ISBN, GTIN-14, etc.)
  // No tiene unique constraint porque distintos tenants pueden compartir el mismo
  // GTIN del fabricante.
  barcode          String?
  name             String
  description      String?
  shortDescription String?
  brand            String?
  basePrice        Decimal  @db.Decimal(12, 2)
  costPrice        Decimal? @db.Decimal(12, 2)
  transferPrice    Decimal? @db.Decimal(12, 2)
  salePrice        Decimal? @db.Decimal(12, 2)
  targetMargin     Decimal? @db.Decimal(5, 2)
  weight           Decimal? @db.Decimal(10, 3)
  dimensions       Json?
  images           Json?
  tags             String[]
  // active | out_of_stock | coming_soon | unavailable
  status           String   @default("active")
  metadata         Json?
  parisData        Json?
  marketplacePricing Json?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants            ProductVariant[]
  inventory           Inventory[]
  marketplaceMappings MarketplaceMapping[]
  stockTransfers      StockTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([status])
  @@index([sku])
  @@index([tenantId, barcode])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String
  name      String
  attributes Json
  price     Decimal? @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)
  weight    Decimal? @db.Decimal(10, 3)
  barcode   String?

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

// =====================
// INVENTORY
// =====================

model Warehouse {
  id            String  @id @default(uuid())
  tenantId      String
  name          String
  address       Json?
  // physical type kept for backwards compat; warehouseType is the new discriminator
  type          String  @default("physical")
  // online | warehouse | store | custom
  warehouseType String  @default("custom")
  isDefault     Boolean @default(false)
  active        Boolean @default(true)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory     Inventory[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, warehouseType])
}

model StockTransfer {
  id              String  @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  productId       String
  variantId       String?
  quantity        Int
  reason          String?
  reference       String?
  userId          String?
  status          String  @default("completed")
  metadata        Json?

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
  @@index([createdAt])
}

model Inventory {
  id               String  @id @default(uuid())
  tenantId         String
  productId        String
  variantId        String?
  warehouseId      String
  quantity         Int     @default(0)
  reservedQuantity Int     @default(0)
  minStock         Int     @default(0)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, variantId, warehouseId])
  @@index([tenantId])
  @@index([productId])
}

model StockMovement {
  id          String  @id @default(uuid())
  inventoryId String
  type        String
  quantity    Int
  reason      String
  reference   String?
  userId      String?
  metadata    Json?

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([reference])
  @@index([createdAt])
}

// =====================
// ORDERS
// =====================

model Sale {
  id               String  @id @default(uuid())
  tenantId         String
  saleNumber       String
  source           String
  externalGroupId  String?

  customerName        String
  customerEmail       String?
  customerPhone       String?
  customerDocType     String?
  customerDocNumber   String?

  invoiceType         String   @default("boleta")
  billingName         String?
  billingDocType      String?
  billingDocNumber    String?
  billingEmail        String?
  billingPhone        String?
  economicActivity    String?
  taxContributor      String?

  shippingAddress Json?
  billingAddress  Json?

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  currency     String  @default("CLP")

  status         String @default("pending")
  paymentStatus  String @default("pending")
  shipmentStatus String @default("pending")

  notes    String?
  metadata Json?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders       Order[]
  taxDocuments TaxDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, saleNumber])
  @@unique([tenantId, source, externalGroupId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id              String  @id @default(uuid())
  tenantId        String
  saleId          String?
  orderNumber     String
  source          String
  sourceChannel   String
  externalOrderId String?
  packId          String?

  customerName        String
  customerEmail       String?
  customerPhone       String?
  customerDocType     String?
  customerDocNumber   String?

  invoiceType         String   @default("boleta")
  billingName         String?
  billingDocType      String?
  billingDocNumber    String?
  billingEmail        String?
  billingPhone        String?
  economicActivity    String?
  taxContributor      String?

  shippingAddress Json?
  billingAddress  Json?

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  currency     String  @default("CLP")

  status        String @default("pending")
  paymentStatus String @default("pending")
  shipmentStatus String @default("pending")

  // Internal-only fulfillment flow. Independent of marketplace status.
  // Values: new | in_preparation | ready_to_ship | cancelled_internal
  internalStatus String @default("new")

  notes    String?
  metadata Json?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  taxDocuments TaxDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([saleId])
  @@index([status])
  @@index([internalStatus])
  @@index([sourceChannel])
  @@index([createdAt])
  @@index([tenantId, packId])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String?
  variantId  String?
  sku        String
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  metadata   Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sku])
}

// =====================
// CONNECTIONS
// =====================

model Connection {
  id          String    @id @default(uuid())
  tenantId    String
  type        String
  provider    String
  name        String
  credentials Json
  config      Json?
  status      String    @default("connected")
  lastSync    DateTime?
  lastError   String?
  syncEnabled Boolean   @default(true)

  // Catalog source: when true, this connection feeds the master catalog.
  // Enforced as max 1 per tenant via a partial unique index in the migration.
  isCatalogSource Boolean @default(false)
  // Catalog sync options (only relevant when isCatalogSource = true).
  // Shape: { autoSyncStock?: boolean, autoSyncPrices?: boolean, autoSyncImages?: boolean }
  catalogConfig   Json?
  // Outcome of the last import/sync run for this source. Surfaced in the UI.
  lastCatalogSyncAt   DateTime?
  lastCatalogSyncStats Json?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marketplaceMappings MarketplaceMapping[]
  syncLogs            SyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([type])
  @@index([tenantId, isCatalogSource])
}

model MarketplaceMapping {
  id                    String    @id @default(uuid())
  productId             String
  connectionId          String
  marketplaceProductId  String?
  marketplaceSku        String?
  marketplaceCategoryId String?
  marketplacePrice      Decimal?  @db.Decimal(12, 2)
  syncStatus            String    @default("pending")
  lastSyncAt            DateTime?
  errorMessage          String?
  formData              Json?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, connectionId])
  @@index([syncStatus])
  @@index([connectionId])
}

// =====================
// SYNC & LOGS
// =====================

model SyncLog {
  id           String  @id @default(uuid())
  tenantId     String
  connectionId String?
  type         String
  action       String
  entity       String
  entityId     String?
  status       String
  requestData  Json?
  responseData Json?
  errorMessage String?
  duration     Int?

  connection Connection? @relation(fields: [connectionId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([connectionId])
  @@index([status])
  @@index([createdAt])
}

model Webhook {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  events        String[]
  secret        String
  active        Boolean   @default(true)
  lastTriggered DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model WebhookDelivery {
  id             String  @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempts       Int     @default(1)
  status         String  @default("pending")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([webhookId])
  @@index([status])
}

// =====================
// TAX DOCUMENTS (BILLING)
// =====================
// Documentos tributarios emitidos vía facturador electrónico (Bsale, etc.).
// Multi-emisor por diseño: el campo `emitter` identifica el provider.
// Una venta puede tener varios docs vinculados (boleta original + nota de
// crédito posterior), de ahí la self-relation TaxDocRefs.
model TaxDocument {
  id       String  @id @default(uuid())
  tenantId String
  saleId   String?
  orderId  String?

  // boleta | factura | nota_credito
  type String

  // pending | issued | failed | cancelled
  status String @default("pending")

  // bsale | haulmer | openfactura | manual | ...
  emitter String @default("bsale")

  // Identificadores devueltos por el emisor.
  externalId String?
  folio      String?
  emittedAt  DateTime?

  pdfUrl String?
  xmlUrl String?

  // Para notas de crédito: apunta al documento original (boleta/factura).
  referenceDocumentId String?
  reference           TaxDocument?  @relation("TaxDocRefs", fields: [referenceDocumentId], references: [id], onDelete: SetNull)
  creditNotes         TaxDocument[] @relation("TaxDocRefs")

  // Snapshot de los datos al momento de emisión, por si la sale cambia luego.
  snapshot Json?

  // Reintentos automáticos. Tras 5 intentos fallidos => status='failed' y la
  // UI ofrece reintento manual.
  lastError String?
  attempts  Int     @default(0)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines  TaxDocumentLine[]

  @@index([tenantId, status])
  @@index([tenantId, saleId])
  @@index([tenantId, orderId])
  @@index([tenantId, emitter, externalId])
  @@index([referenceDocumentId])
}

// Líneas del documento. Guardamos `externalLineId` (documentDetailId en Bsale)
// porque la NC total exige referenciar cada línea original.
model TaxDocumentLine {
  id             String  @id @default(uuid())
  taxDocumentId  String
  externalLineId String?
  sku            String
  name           String
  quantity       Decimal  @db.Decimal(12, 3)
  netUnitValue   Decimal  @db.Decimal(12, 2)
  taxIds         String[]
  discount       Decimal  @default(0) @db.Decimal(5, 2)

  document TaxDocument @relation(fields: [taxDocumentId], references: [id], onDelete: Cascade)

  @@index([taxDocumentId])
}

// Eventos webhook recibidos desde marketplaces. Sirve para:
//  - Idempotencia: dedup por (provider, externalEventId).
//  - Auditoría: ver qué llegó cuando algo no calza con la orden en DB.
//  - Reintento: si la verificación pasa pero el procesamiento falla.
model MarketplaceWebhookEvent {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String
  // ID del evento que reporta el marketplace (si lo hay). Único por provider
  // para deduplicar entregas duplicadas.
  externalEventId String?
  topic           String?
  externalResourceId String?
  // Payload crudo + headers para auditoría.
  payload         Json
  headers         Json?
  signatureValid  Boolean  @default(false)

  status          String   @default("received")  // received | processed | failed | ignored
  processedAt     DateTime?
  error           String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([tenantId, provider])
  @@index([status])
  @@index([createdAt])
}

// Cache local de clientes Bsale por RUT. Bsale no expone GET por código,
// así que cacheamos para no duplicar y no iterar en cada emisión.
model BsaleClientCache {
  id                String  @id @default(uuid())
  tenantId          String
  rut               String
  externalClientId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, rut])
  @@index([tenantId])
}
